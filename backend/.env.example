APP_NAME=University LMS API
APP_ENV=development
DEBUG=true
API_V1_STR=/api

# SQL Server connection string. Leave driver as SQL Server or installed ODBC Driver 17/18 for SQL Server.
DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/UniversityLms?driver=SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Replace JWT_SECRET with a random 32+ character string before deploying outside development/test
JWT_SECRET=change-this-dev-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated CORS origins or JSON array
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Google Gemini integration (empty -> deterministic local fallback mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local file vault upload limits and directory
FILE_MAX_SIZE_MB=25
FILE_VAULT_DIR=backend/storage/vault
