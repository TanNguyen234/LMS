# Backend Environment Configuration
APP_NAME="University LMS API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api

# Database connection string (SQL Server)
DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/UniversityLms?driver=SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# JWT Security
JWT_SECRET=university-lms-super-secret-jwt-key-2026-pm-academic
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Upload storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
